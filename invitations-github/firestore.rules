rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    function admin(){ return request.auth != null && request.auth.uid == 'VbyZi9dmamgXnybMrJdo86AyDA72'; }
    match /events/{e} {
      allow get: if true;                       // من يملك رابط الفعالية فقط (المعرّف عشوائي)
      allow list, create, update, delete: if admin();
      match /guests/{g} { allow read, create, update, delete: if true; }
      match /scans/{s}  { allow read: if true; allow create: if true; }  // لا تعديل: المسح المكرر يُرفض تلقائياً
    }
  }
}
